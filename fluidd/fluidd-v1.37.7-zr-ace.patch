+        Locked while printing
+      </div>
+      <div class="zr-actions">
+        <app-btn
+          v-for="action in actions"
+          :key="action.label"
+          small
+          :color="action.color"
+          :outlined="action.outlined"
+          :disabled="action.disabled"
+          :title="action.hint"
