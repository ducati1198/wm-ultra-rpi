+    }, POLL_MS)
+  }
+
+  beforeDestroy () {
+    if (this.pollTimer != null) window.clearInterval(this.pollTimer)
+  }
+
+  get syncChip () {
+    if (zrShared.error) return { text: 'Screen colours unavailable', color: 'error' }
+    if (zrShared.screenNeedsRestart) return { text: 'Screen restart needed', color: 'info' }
+    if (!zrShared.loaded) return { text: 'Loading…', color: undefined }
+    return { text: 'Synced with screen', color: 'success' }
+  }
+
+  get carriageText () {
+    const t = this.zrActiveTool
+    return t < 0 ? 'none' : `Toolhead ${t + 1} (T${t})`
+  }
+
+  get mappingText () {
+    const changed = this.zrMapping
+      .map((head, tool) => head === tool ? null : `T${tool}→T${head}`)
+      .filter(Boolean)
+    return changed.length ? changed.join(' ') : 'Direct'
+  }
+
+  get positionText () {
+    const t = this.zrActiveTool
+    const docked = this.zrHeads.filter(h => h.docked === true).length
+    if (this.zrPrintState === 'printing' && t >= 0) return `Printing with T${t}`
+    if (t < 0) return `Docked: ${docked} · Carriage empty`
+    return `Docked: ${docked} · On carriage: T${t}`
+  }
