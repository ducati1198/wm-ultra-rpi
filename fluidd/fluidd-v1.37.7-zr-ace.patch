+++ b/src/components/widgets/zr/ZrPrintDialog.vue
@@ -185,6 +185,7 @@ export default class ZrPrintDialog extends Mixins(ZrMixin) {
     this.map = []
     this.filename = null
     this.chooseFile = !payload?.filename
+    // Start reading the toolhead colours now; selectFile waits for them.
     if (!zrShared.loaded) this.zrLoadSlots()
 
     if (payload?.filename) {
@@ -253,6 +254,9 @@ export default class ZrPrintDialog extends Mixins(ZrMixin) {
       }
     }
 
+    // Suggestions compare against the toolhead colours from tmt1.ini.
+    if (!zrShared.loaded) await this.zrLoadSlots()
+
     if (token !== this.token) return
     this.colours = colours
     this.map = this.suggest(colours)
diff --git a/src/components/widgets/zr/zrMixin.ts b/src/components/widgets/zr/zrMixin.ts
index 2b78324..e1f06c0 100644
--- a/src/components/widgets/zr/zrMixin.ts
+++ b/src/components/widgets/zr/zrMixin.ts
@@ -21,6 +21,9 @@ export const zrShared = Vue.observable({
   screenNeedsRestart: false
 })
 
+// The tmt1.ini read in flight, so a second caller waits for it instead of returning early.
+let zrLoadPromise: Promise<void> | null = null
+
 export interface ZrHead {
   index: number
   heater: string
@@ -128,8 +131,13 @@ export default class ZrMixin extends Mixins(StateMixin, FilesMixin) {
     return zrShared
   }
 
-  async zrLoadSlots (): Promise<void> {
-    if (zrShared.loading) return
+  zrLoadSlots (): Promise<void> {
+    if (zrLoadPromise) return zrLoadPromise
+    zrLoadPromise = this.zrReadSlots().finally(() => { zrLoadPromise = null })
+    return zrLoadPromise
+  }
+
+  private async zrReadSlots (): Promise<void> {
     zrShared.loading = true
     try {
       const response = await this.serverFilesGet<string>(TMT1_PATH, { responseType: 'text', transformResponse: [(d: unknown) => d] })
