+          label="Search files"
+          class="mb-2"
+        />
+        <div class="zr-files">
+          <button
+            v-for="f in visibleFiles"
+            :key="f.path"
+            type="button"
+            class="zr-file"
+            :class="{ 'zr-file--selected': f.path === filename }"
+            :aria-pressed="f.path === filename ? 'true' : 'false'"
+            @click="selectFile(f.path)"
+          >
+            <span class="zr-file-name">{{ f.path }}</span>
+            <span class="zr-file-date">{{ f.date }}</span>
+          </button>
+          <div
+            v-if="visibleFiles.length === 0 && !loading"
+            class="pa-2 text-caption secondary--text"
+          >
+            No G-code files found.
+          </div>
+        </div>
+      </template>
+
+      <template v-if="filename">
+        <div
+          v-if="thumbnailUrl || fileStats.length"
+          class="zr-preview my-3"
+        >
+          <img
+            v-if="thumbnailUrl"
+            :src="thumbnailUrl"
+            alt=""
+            class="zr-thumb"
+          >
+          <div class="zr-stats">
+            <div
+              v-for="s in fileStats"
+              :key="s.label"
+            >
+              <div class="text-caption secondary--text">
+                {{ s.label }}
+              </div>
+              <div class="font-weight-medium">
+                {{ s.value }}
+              </div>
+            </div>
+          </div>
+        </div>
+
+        <div
+          v-if="!loading && colours.length === 0"
+          class="my-3"
+        >
+          <v-alert
+            dense
+            text
+            type="info"
+          >
+            This file has no colour information. It will print with the toolheads set in the slicer (T0 → Toolhead 1, and so on).
+          </v-alert>
+        </div>
+
+        <template v-else-if="colours.length">
+          <div class="text-overline secondary--text mt-2">
+            File colour → toolhead
+          </div>
+          <div
+            v-for="(c, row) in colours"
+            :key="c.tool"
+            class="zr-map-row"
+          >
+            <div class="zr-map-file">
+              <span
+                class="zr-dot zr-dot--lg"
+                :style="{ background: c.hex }"
+              />
+              <span>
+                <span class="d-block">File T{{ c.tool }}</span>
+                <span class="text-caption secondary--text">{{ c.material || '' }}{{ c.grams != null ? ` · ${c.grams.toFixed(1)} g` : '' }}</span>
+              </span>
+            </div>
+            <div class="zr-map-heads">
+              <button
+                v-for="head in zrHeads"
+                :key="head.index"
+                type="button"
+                class="zr-head-btn"
+                :class="{
+                  'zr-head-btn--selected': map[row] === head.index,
+                  'zr-head-btn--empty': head.loaded === false
+                }"
+                :aria-pressed="map[row] === head.index ? 'true' : 'false'"
+                :aria-label="`Print file colour T${c.tool} with toolhead ${head.index + 1}${head.loaded === false ? ' (empty)' : ''}`"
+                @click="setMap(row, head.index)"
+              >
+                <span
+                  class="zr-dot"
+                  :style="{ background: head.loaded === false ? 'transparent' : head.colorCss }"
+                />
+                T{{ head.index }}
+              </button>
+            </div>
+          </div>
+
+          <v-alert
+            v-for="w in warnings"
+            :key="w.text"
+            dense
+            text
+            :type="w.type"
+            class="mt-2 mb-0"
+          >
+            {{ w.text }}
+          </v-alert>
+        </template>
+      </template>
+    </v-card-text>
+  </app-dialog>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import { httpClientActions } from '@/api/httpClientActions'
+import { SocketActions } from '@/api/socketActions'
+import { EventBus } from '@/eventBus'
+import ZrMixin, { zrShared } from './zrMixin'
+import {
+  ZR_HEADS, ZR_PALETTE, colorDistance, fileColoursFromMetadata, fileColoursFromTail,
+  type ZrFileColour
+} from './zr'
+
+interface GcodeFile { path: string, modified: number, date: string }
+
+@Component({})
+export default class ZrPrintDialog extends Mixins(ZrMixin) {
+  open = false
+  loading = false
+  starting = false
+  chooseFile = false
+  search = ''
+  files: GcodeFile[] = []
+  filename: string | null = null
+  meta: Record<string, any> = {}
+  colours: ZrFileColour[] = []
+  map: number[] = []
+  token = 0
+
+  created () {
+    EventBus.bus.$on('zr-print-dialog', this.handleOpen)
+  }
+
+  beforeDestroy () {
+    EventBus.bus.$off('zr-print-dialog', this.handleOpen)
+  }
+
+  async handleOpen (payload: { filename: string | null }) {
+    this.open = true
+    this.search = ''
+    this.meta = {}
+    this.colours = []
+    this.map = []
+    this.filename = null
+    this.chooseFile = !payload?.filename
+    if (!zrShared.loaded) this.zrLoadSlots()
+
+    if (payload?.filename) {
+      await this.selectFile(payload.filename)
+    } else {
+      await this.loadFiles()
+    }
+  }
+
+  get subTitle () {
+    return this.filename ?? 'Choose a file to print'
+  }
+
+  get visibleFiles () {
+    const q = (this.search ?? '').toLowerCase()
+    return this.files
+      .filter(f => !q || f.path.toLowerCase().includes(q))
+      .slice(0, 60)
+  }
+
+  async loadFiles () {
+    this.loading = true
+    try {
+      const res = await httpClientActions.get<{ result: Array<{ path: string, modified: number }> }>('/server/files/list?root=gcodes')
+      this.files = (res.data.result ?? [])
+        .filter(f => /\.(gcode|g|gco)$/i.test(f.path) && !f.path.startsWith('.'))
+        .sort((a, b) => b.modified - a.modified)
+        .map(f => ({ path: f.path, modified: f.modified, date: new Date(f.modified * 1000).toLocaleString() }))
+    } catch {
+      this.files = []
+    } finally {
+      this.loading = false
+    }
+  }
+
+  encodePath (path: string) {
+    return path.split('/').map(encodeURIComponent).join('/')
+  }
+
+  async selectFile (path: string) {
+    const token = ++this.token
+    this.filename = path
+    this.loading = true
+    this.colours = []
+    this.map = []
+    this.meta = {}
+
+    try {
+      const res = await httpClientActions.get<{ result: Record<string, any> }>(`/server/files/metadata?filename=${encodeURIComponent(path)}`)
+      if (token !== this.token) return
+      this.meta = res.data.result ?? {}
+    } catch {
+      this.meta = {}
+    }
+
+    let colours = fileColoursFromMetadata(this.meta)
+
+    if (colours.length === 0) {
+      // Older metadata: read the slicer settings at the end of the file.
+      try {
+        const res = await httpClientActions.get<string>(`/server/files/gcodes/${this.encodePath(path)}`, {
+          responseType: 'text',
+          headers: { Range: 'bytes=-60000' },
+          transformResponse: [(d: unknown) => d]
+        })
+        if (token !== this.token) return
+        colours = fileColoursFromTail(String(res.data ?? ''))
+      } catch {
+        colours = []
+      }
+    }
+
+    if (token !== this.token) return
+    this.colours = colours
+    this.map = this.suggest(colours)
+    this.loading = false
+  }
+
+  /** Closest declared colour among loaded heads, each head used once where possible. */
+  suggest (colours: ZrFileColour[]): number[] {
+    const heads = this.zrHeads.filter(h => h.loaded !== false && h.colorHex != null)
+    const pairs: Array<{ row: number, head: number, d: number }> = []
+    colours.forEach((c, row) => {
+      for (const h of heads) pairs.push({ row, head: h.index, d: colorDistance(c.hex, h.colorHex as string) })
+    })
+    pairs.sort((a, b) => a.d - b.d)
+
+    const result: number[] = colours.map(() => -1)
+    const usedHeads = new Set<number>()
+    for (const p of pairs) {
+      if (result[p.row] >= 0 || usedHeads.has(p.head)) continue
+      result[p.row] = p.head
+      usedHeads.add(p.head)
+    }
+    // More colours than heads with filament: fall back to the closest head, even if shared.
+    colours.forEach((c, row) => {
+      if (result[row] >= 0) return
+      const best = pairs.find(p => p.row === row)
+      result[row] = best ? best.head : (c.tool < ZR_HEADS ? c.tool : 0)
+    })
+    return result
+  }
+
+  setMap (row: number, head: number) {
+    this.$set(this.map, row, head)
+  }
+
+  get thumbnailUrl (): string | null {
+    const thumbs = Array.isArray(this.meta.thumbnails) ? [...this.meta.thumbnails] : []
+    if (!thumbs.length || !this.filename) return null
+    thumbs.sort((a: any, b: any) => (b.width ?? 0) - (a.width ?? 0))
+    const rel = thumbs[0].relative_path
+    if (!rel) return null
+    const dir = this.filename.includes('/') ? this.filename.slice(0, this.filename.lastIndexOf('/') + 1) : ''
+    const base = String(httpClientActions.defaults.baseURL ?? '').replace(/\/$/, '')
+    return `${base}/server/files/gcodes/${this.encodePath(dir + rel)}`
+  }
+
+  get fileStats () {
+    const m = this.meta
+    const stats: Array<{ label: string, value: string }> = []
+    if (m.estimated_time) {
+      const t = Math.round(Number(m.estimated_time) / 60)
+      stats.push({ label: 'Time', value: `${Math.floor(t / 60)} h ${String(t % 60).padStart(2, '0')} min` })
+    }
+    if (m.filament_weight_total) stats.push({ label: 'Filament', value: `${Number(m.filament_weight_total).toFixed(1)} g` })
+    if (m.layer_height) stats.push({ label: 'Layer', value: `${m.layer_height} mm` })
+    if (m.slicer) stats.push({ label: 'Slicer', value: String(m.slicer) })
+    return stats
+  }
+
+  get warnings () {
+    const list: Array<{ type: string, text: string }> = []
+    const heads = this.zrHeads
+    const count: Record<number, number> = {}
+
+    this.map.forEach((h, row) => {
+      count[h] = (count[h] ?? 0) + 1
+      const head = heads[h]
+      const fileTool = this.colours[row]?.tool
+      if (head?.loaded === false) {
+        list.push({ type: 'error', text: `File T${fileTool} is set to toolhead ${h + 1}, which has no filament.` })
+      }
+      const fileMat = (this.colours[row]?.material ?? '').toUpperCase()
+      const headMat = (head?.materialName ?? '').toUpperCase()
+      if (fileMat && head?.slot.material != null && !headMat.startsWith(fileMat.split(/[-\s]/)[0])) {
+        list.push({ type: 'warning', text: `File T${fileTool} is ${this.colours[row].material}, toolhead ${h + 1} is set to ${head.materialName}.` })
+      }
+    })
+
+    Object.entries(count).forEach(([h, n]) => {
+      if (n > 1) list.push({ type: 'warning', text: `Toolhead ${+h + 1} will print ${n} file colours with the same filament.` })
+    })
+
+    if (this.zrBusy) list.unshift({ type: 'error', text: 'The printer is busy. Wait for the current print to finish.' })
+    return list
+  }
+
+  get blocked () {
+    if (!this.filename || this.loading || this.zrBusy || !this.klippyReady) return true
+    return this.warnings.some(w => w.type === 'error')
+  }
+
+  async confirm () {
+    if (this.blocked || !this.filename) return
+    this.starting = true
+    const filename = this.filename
+
+    try {
+      if (this.colours.length) {
+        const mapping = Array.from({ length: ZR_HEADS }, (_, t) => t)
+        this.colours.forEach((c, row) => {
+          if (c.tool < ZR_HEADS) mapping[c.tool] = this.map[row]
+        })
+        const lines: string[] = []
+        mapping.forEach((head, tool) => {
+          lines.push(`SAVE_VARIABLE VARIABLE=box_modify_t${tool} VALUE=${head}`)
+          lines.push(`SAVE_VARIABLE VARIABLE=box_modify_t${tool}_backup VALUE=${head}`)
+        })
+        await SocketActions.printerGcodeScript(lines.join('\n'))
+        this.addConsoleEntry(lines.join('\n'))
+      }
+
+      await SocketActions.printerPrintStart(filename)
+      const summary = this.colours.map((c, row) => `T${c.tool}→Toolhead ${this.map[row] + 1}`).join(', ')
+      EventBus.$emit(`Printing ${filename}${summary ? ` (${summary})` : ''}`, { type: 'success', timeout: 5000 })
+      this.open = false
+      if (this.$route.name !== 'home') this.$router.push({ name: 'home' })
+    } catch {
+      EventBus.$emit('Could not start the print. Check the console.', { type: 'error', timeout: 8000 })
+    } finally {
+      this.starting = false
+    }
+  }
+
+  get palette () {
+    return ZR_PALETTE
+  }
+}
+</script>
+
