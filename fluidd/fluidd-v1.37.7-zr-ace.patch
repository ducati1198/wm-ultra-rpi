+<template>
+  <app-dialog
+    v-model="open"
+    title="Print with colours"
+    :sub-title="subTitle"
+    :max-width="$vuetify.breakpoint.smAndDown ? undefined : 620"
+    :loading="loading"
+    save-button-text="Print"
+    :save-button-disabled="blocked"
+    :save-button-loading="starting"
+    @save="confirm"
+  >
