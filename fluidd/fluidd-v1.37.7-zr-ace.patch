+    if (this.isPrintingHead(head)) return { text: 'PRINTING', color: 'warning' }
+    if (head.onCarriage) return { text: 'ACTIVE', color: 'primary' }
+    if (head.loaded == null) return { text: 'UNKNOWN', color: 'secondary' }
+    return { text: 'READY', color: 'success' }
