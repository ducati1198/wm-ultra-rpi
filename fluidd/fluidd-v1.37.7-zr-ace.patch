+export interface ZrPaletteEntry { name: string, hex: string, css?: string }
+
+// Touchscreen colour swatches, row by row from index 0.
+export const ZR_PALETTE: ZrPaletteEntry[] = [
+  { name: 'White', hex: '#FFFFFF' },
+  { name: 'Beige', hex: '#F3E8C8' },
