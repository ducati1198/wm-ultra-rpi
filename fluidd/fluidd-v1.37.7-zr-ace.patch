+import { EventBus } from '@/eventBus'
+import { fileColoursFromMetadata } from './zr'
+
+/**
+ * Called before Fluidd starts a print. On a ZR Ultra-S, multi-colour files
+ * (or a single-colour file whose toolhead is empty) open the colour dialog
+ * instead of starting straight away. Returns true when the dialog took over.
+ */
+export const zrInterceptPrint = (printer: Record<string, any>, filename: string, file: Record<string, unknown> | null | undefined): boolean => {
+  const isUltraS = printer['filament_switch_sensor docked0'] != null && printer['filament_switch_sensor filament0'] != null
+  if (!isUltraS || !file) return false
+
+  const colours = fileColoursFromMetadata(file)
+  if (colours.length === 0) return false
+
+  let show = colours.length > 1
+  if (!show) {
+    const tool = colours[0].tool
+    const variables = printer.save_variables?.variables ?? {}
+    const head = Number.isInteger(Number(variables[`box_modify_t${tool}`])) ? Number(variables[`box_modify_t${tool}`]) : tool
+    show = printer[`filament_switch_sensor filament${head}`]?.filament_detected === false
+  }
+
+  if (show) {
+    EventBus.bus.$emit('zr-print-dialog', { filename })
+  }
+  return show
+}
