@@ -0,0 +1,180 @@
+import Vue from 'vue'
+import { Component, Mixins } from 'vue-property-decorator'
+import StateMixin from '@/mixins/state'
+import { httpClientActions } from '@/api/httpClientActions'
+import { encodeGcodeParamValue } from '@/util/gcode-helpers'
+import {
+  ZR_HEADS, ZR_MATERIALS, ZR_PALETTE,
+  parseTmt1Slots, updateTmt1Slot, zrColorName, zrMaterialName, zrSwatchCss,
+  type ZrSlot
+} from './zr'
+
+const TMT1_PATH = 'config/tmt1.ini'
+
+// Shared between the card and the dialogs.
+export const zrShared = Vue.observable({
+  slots: Array.from({ length: ZR_HEADS }, () => ({ color: null, material: null })) as ZrSlot[],
+  raw: '' as string,
+  loaded: false,
+  loading: false,
+  error: '' as string,
+  screenNeedsRestart: false
+})
+
+export interface ZrHead {
+  index: number
+  heater: string
+  slot: ZrSlot
+  colorCss: string
+  colorHex: string | null
+  colorName: string
+  materialName: string
+  temp: number
+  actual: number
+  target: number
+  loaded: boolean | null
+  docked: boolean | null
+  onCarriage: boolean
+}
+
+@Component
+export default class ZrMixin extends Mixins(StateMixin) {
+  get zrPrinter (): Record<string, any> {
+    return this.$typedState.printer.printer as Record<string, any>
+  }
+
+  get zrIsUltraS (): boolean {
+    const p = this.zrPrinter
+    return p['filament_switch_sensor docked0'] != null && p['filament_switch_sensor filament0'] != null
+  }
+
+  get zrVariables (): Record<string, any> {
+    return this.zrPrinter.save_variables?.variables ?? {}
+  }
+
+  get zrPrintState (): string {
+    return this.zrPrinter.print_stats?.state ?? ''
+  }
+
+  get zrBusy (): boolean {
+    return ['printing', 'paused'].includes(this.zrPrintState)
+  }
+
+  get zrActiveTool (): number {
+    const v = this.zrVariables.current_extruder
+    if (v != null) {
+      const n = Number(v)
+      return n >= 0 && n < ZR_HEADS ? n : -1
+    }
+    const ext: string = this.zrPrinter.toolhead?.extruder ?? ''
+    if (ext === 'extruder') return 0
+    const m = /^extruder(\d)$/.exec(ext)
+    return m ? +m[1] : -1
+  }
+
+  get zrMapping (): number[] {
+    return Array.from({ length: ZR_HEADS }, (_, i) => {
+      const v = Number(this.zrVariables[`box_modify_t${i}`])
+      return Number.isInteger(v) && v >= 0 && v < ZR_HEADS ? v : i
+    })
+  }
+
+  zrHasMacro (name: string): boolean {
+    const p = this.zrPrinter
+    return p[`gcode_macro ${name}`] != null || p[`gcode_macro ${name.toLowerCase()}`] != null
+  }
+
+  zrHeater (index: number): string {
+    return index === 0 ? 'extruder' : `extruder${index}`
+  }
+
+  zrSensor (name: string): boolean | null {
+    const s = this.zrPrinter[`filament_switch_sensor ${name}`]
+    return s && typeof s.filament_detected === 'boolean' ? s.filament_detected : null
+  }
+
+  zrSavedTemp (index: number): number {
+    const saved = Number(this.zrVariables[`zr_t${index}_temp`])
+    if (saved >= 150 && saved <= 350) return saved
+    const material = zrShared.slots[index]?.material
+    return material != null ? ZR_MATERIALS[material].temp : 220
+  }
+
+  get zrHeads (): ZrHead[] {
+    const active = this.zrActiveTool
+    return Array.from({ length: ZR_HEADS }, (_, index) => {
+      const slot = zrShared.slots[index]
+      const heater = this.zrHeater(index)
+      const h = this.zrPrinter[heater] ?? {}
+      return {
+        index,
+        heater,
+        slot,
+        colorCss: zrSwatchCss(slot.color),
+        colorHex: slot.color != null ? ZR_PALETTE[slot.color].hex : null,
+        colorName: zrColorName(slot.color),
+        materialName: zrMaterialName(slot.material),
+        temp: this.zrSavedTemp(index),
+        actual: Math.round(Number(h.temperature ?? 0)),
+        target: Math.round(Number(h.target ?? 0)),
+        loaded: this.zrSensor(`filament${index}`),
+        docked: this.zrSensor(`docked${index}`),
+        onCarriage: index === active
+      }
+    })
+  }
+
+  get zrShared () {
+    return zrShared
+  }
+
+  async zrLoadSlots (): Promise<void> {
+    if (zrShared.loading) return
+    zrShared.loading = true
+    try {
+      const response = await httpClientActions.serverFilesGet<string>(TMT1_PATH, { responseType: 'text', transformResponse: [(d: unknown) => d] })
+      const text = String(response.data ?? '')
+      zrShared.raw = text
+      zrShared.slots = parseTmt1Slots(text)
+      zrShared.loaded = true
+      zrShared.error = ''
+    } catch (e) {
+      zrShared.error = 'Could not read tmt1.ini from the printer'
+    } finally {
+      zrShared.loading = false
+    }
+  }
+
+  /** Writes one slot to tmt1.ini and the ZR Tools variables, keeping everything else unchanged. */
+  async zrSaveSlot (index: number, color: number, material: number, temp: number): Promise<void> {
+    // Re-read first so a change made on the touchscreen meanwhile is not lost.
+    const response = await httpClientActions.serverFilesGet<string>(TMT1_PATH, { responseType: 'text', transformResponse: [(d: unknown) => d] })
+    const current = String(response.data ?? '')
+    const updated = updateTmt1Slot(current, index, color, material)
+
+    if (updated !== current) {
+      const file = new File([updated], 'tmt1.ini', { type: 'text/plain' })
+      await httpClientActions.serverFilesUploadPost(file, '', 'config')
+      zrShared.screenNeedsRestart = true
+    }
+
+    zrShared.raw = updated
+    zrShared.slots = parseTmt1Slots(updated)
+
+    const hex = parseInt(ZR_PALETTE[color].hex.slice(1), 16)
+    const zrMat = ZR_MATERIALS[material].zr
+    this.zrSend([
+      `SAVE_VARIABLE VARIABLE=zr_t${index}_temp VALUE=${Math.round(temp)}`,
+      `SAVE_VARIABLE VARIABLE=zr_t${index}_color VALUE=${hex}`,
+      `SAVE_VARIABLE VARIABLE=zr_t${index}_mat VALUE=${zrMat}`
+    ])
+  }
+
+  zrSend (lines: string[] | string, wait?: string) {
+    this.sendGcode(Array.isArray(lines) ? lines.join('\n') : lines, wait)
+  }
+
+  zrQuote (value: string) {
+    return encodeGcodeParamValue(value)
+  }
+}
