+
+<script lang="ts">
+import { Component, Mixins, Prop, VModel } from 'vue-property-decorator'
+import { EventBus } from '@/eventBus'
+import ZrMixin, { zrShared } from './zrMixin'
+import { ZR_MATERIALS, ZR_PALETTE, zrColorName, zrSwatchCss } from './zr'
+
+interface ZrAction { label: string, color?: string, outlined?: boolean, disabled: boolean, hint?: string, run: () => void }
+
+@Component({})
+export default class ZrToolDialog extends Mixins(ZrMixin) {
+  @VModel({ type: Boolean })
+  open?: boolean
+
+  @Prop({ type: Number, required: true })
+  readonly index!: number
+
+  material = 0
+  color = 0
+  temp = 210
+  saving = false
+
+  created () {
+    const slot = zrShared.slots[this.index]
+    this.material = slot.material ?? 0
+    this.color = slot.color ?? 0
+    this.temp = this.zrSavedTemp(this.index)
+  }
+
+  get palette () {
+    return ZR_PALETTE
+  }
+
+  get materialItems () {
+    return ZR_MATERIALS.map((m, value) => ({ text: m.name, value }))
+  }
+
+  get colorName () {
+    return zrColorName(this.color)
+  }
+
+  swatchCss (i: number) {
+    return zrSwatchCss(i)
+  }
+
+  onMaterialChange (value: number) {
+    // Suggest the usual temperature for the newly chosen material.
+    this.temp = ZR_MATERIALS[value].temp
+  }
+
+  get head () {
+    return this.zrHeads[this.index]
+  }
+
+  get homed () {
+    const axes: string = this.zrPrinter.toolhead?.homed_axes ?? ''
+    return axes.includes('x') && axes.includes('y') && axes.includes('z')
+  }
+
+  get actions (): ZrAction[] {
+    const i = this.index
+    const head = this.head
+    const busy = this.zrBusy || !this.klippyReady
+    const list: ZrAction[] = []
+    const heating = head.target > 0
+
+    list.push({
+      label: 'Select',
+      color: 'primary',
+      disabled: busy || head.onCarriage || !this.homed,
+      hint: !this.homed ? 'Home all axes first' : undefined,
+      run: () => this.run(`_CHANGE_TOOL T=${i}`, `Picking up toolhead ${i + 1}`)
+    })
+
+    if (head.onCarriage && this.zrHasMacro('PARK_CURRENT_TOOL')) {
+      list.push({
+        label: 'Park',
+        color: 'warning',
+        disabled: busy || !this.homed,
+        run: () => this.run('PARK_CURRENT_TOOL', `Parking toolhead ${i + 1}`)
+      })
+    }
+
+    const loadMacro = this.zrHasMacro('ZR_LOAD') ? 'ZR_LOAD' : 'LOAD_FILAMENT'
+    const unloadMacro = this.zrHasMacro('ZR_UNLOAD') ? 'ZR_UNLOAD' : 'UNLOAD_FILAMENT'
+    list.push({
+      label: 'Load',
+      color: 'success',
+      outlined: true,
+      disabled: busy,
+      hint: `Heats toolhead ${i + 1} and feeds filament`,
+      run: () => this.run(`${loadMacro} T=${i}`, `Loading toolhead ${i + 1}`)
+    })
+    list.push({
+      label: 'Unload',
+      color: 'error',
+      outlined: true,
+      disabled: busy,
+      hint: `Heats toolhead ${i + 1} and retracts filament`,
+      run: () => this.run(`${unloadMacro} T=${i}`, `Unloading toolhead ${i + 1}`)
+    })
+    list.push({
+      label: heating ? 'Cool' : 'Heat',
+      color: heating ? undefined : 'deep-orange',
+      disabled: !this.klippyReady,
+      run: () => this.run(`SET_HEATER_TEMPERATURE HEATER=${head.heater} TARGET=${heating ? 0 : this.temp}`, heating ? 'Heater off' : `Heating to ${this.temp}°C`)
+    })
+
+    if (this.zrHasMacro('ZR_PURGE')) {
+      list.push({
+        label: 'Purge',
+        color: 'warning',
+        outlined: true,
+        disabled: busy || !head.onCarriage || !this.homed,
+        hint: head.onCarriage ? 'Purges 100 mm and wipes the nozzle' : 'Select this toolhead first',
+        run: () => this.run(`ZR_PURGE TEMP=${this.temp}`, 'Purging')
+      })
+    }
+
+    if (this.zrHasMacro('CALIBRATE_TOOL_Z_OFFSET')) {
+      list.push({
+        label: 'Z offset',
+        color: 'primary',
+        outlined: true,
+        disabled: busy,
+        hint: 'Runs the WonderMaker Z offset calibration for this toolhead',
+        run: () => this.run(`CALIBRATE_TOOL_Z_OFFSET T=${i}`, 'Calibrating Z offset')
+      })
+    }
+
+    return list
+  }
+
+  run (gcode: string, message: string) {
+    this.zrSend(gcode)
+    EventBus.$emit(message, { timeout: 3000 })
+  }
+
+  async save () {
+    this.saving = true
+    try {
+      await this.zrSaveSlot(this.index, this.color, this.material, this.temp)
+      EventBus.$emit(`Toolhead ${this.index + 1}: ${zrColorName(this.color)} ${ZR_MATERIALS[this.material].name}, ${this.temp}°C saved`, { type: 'success', timeout: 4000 })
+      this.open = false
+    } catch {
+      EventBus.$emit('Could not save to the printer (tmt1.ini)', { type: 'error', timeout: 8000 })
+    } finally {
+      this.saving = false
+    }
+  }
+}
+</script>
