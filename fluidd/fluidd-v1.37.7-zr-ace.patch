--- a/src/components/widgets/zr/zrMixin.ts
+++ b/src/components/widgets/zr/zrMixin.ts
@@ -59,6 +59,78 @@ export default class ZrMixin extends Mixins(StateMixin, FilesMixin) {
     return this.zrPrinter.print_stats?.state ?? ''
   }
 
+  // ---- ACE Pro feeder/dryer (slot N feeds toolhead N). Shown only when the ACE macros/driver exist.
+  get zrHasAce (): boolean {
+    return this.zrPrinter['gcode_macro _WM_ACE'] != null || this.zrPrinter.ace != null
+  }
+
+  get zrAce (): Record<string, any> {
+    const o = this.zrPrinter.ace_instance_0
+    return o != null && typeof o === 'object' ? o : {}
+  }
+
+  get zrAceConnected (): boolean {
+    const state = this.zrAce.connection_state
+    return Object.keys(this.zrAce).length > 0 && (state == null || state === 'connected')
+  }
+
+  get zrAceWm (): Record<string, any> {
+    return this.zrPrinter['gcode_macro _WM_ACE'] ?? {}
+  }
+
+  get zrAceDryer (): Record<string, any> {
+    return this.zrAce.dryer_status ?? this.zrAce.dryer ?? { status: 'stop' }
+  }
+
+  get zrAceDrying (): boolean {
+    const s = this.zrAceDryer.status
+    return s != null && !['stop', 'stopped', 'idle', 'unknown'].includes(s)
+  }
+
+  get zrAceDryRemaining (): string {
+    // ACE Pro reports minutes, ACE 2 seconds
+    const d = this.zrAceDryer
+    const remain = Math.max(0, d.remain_time ?? 0)
+    const duration = d.duration ?? 0
+    const total = duration > 0 ? (remain > duration + 1 ? remain : remain * 60) : (remain < 1000 ? remain * 60 : remain)
+    const h = Math.floor(total / 3600)
+    const m = Math.floor((total % 3600) / 60)
+    return h > 0 ? `${h}h ${m.toString().padStart(2, '0')}m` : `${m}m`
+  }
+
+  zrAceSlot (index: number): Record<string, any> | null {
+    const slots = this.zrAce.slots
+    return Array.isArray(slots) ? (slots.find((s: any) => s?.index === index) ?? null) : null
+  }
+
+  zrAceSlotEmpty (index: number): boolean {
+    return this.zrAceSlot(index)?.status === 'empty'
+  }
+
+  zrAceFeedAssist (index: number): boolean {
+    return this.zrAce.feed_assist_slot === index
+  }
+
+  /** Status word + colour for the ACE slot feeding toolhead `index`. */
+  zrAceTileStatus (index: number): { text: string, color: string } {
+    const wm = this.zrAceWm
+    const mode = String(wm.mode ?? 'idle')
+    if (Number(wm.tool) === index && mode.startsWith('load')) return { text: 'loading', color: 'orange' }
+    if (Number(wm.tool) === index && mode.startsWith('unload')) return { text: 'unloading', color: 'orange' }
+    if (this.zrAceFeedAssist(index)) return { text: 'assist', color: 'orange' }
+    const slot = this.zrAceSlot(index)
+    if (slot == null) return { text: 'no data', color: 'grey' }
+    if (slot.status === 'empty') return { text: 'empty', color: 'grey' }
+    if (slot.status === 'ready') return { text: 'ready', color: 'success' }
+    return { text: String(slot.status ?? 'unknown'), color: 'warning' }
+  }
+
+  /** Hub inlet sensor (path_N): true/false, null when the sensor does not exist. */
+  zrHubDetected (index: number): boolean | null {
+    const s = this.zrPrinter[`filament_switch_sensor path_${index}`]
+    return s == null ? null : s.filament_detected === true
+  }
+
   get zrBusy (): boolean {
     return ['printing', 'paused'].includes(this.zrPrintState)
   }
