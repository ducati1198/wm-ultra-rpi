+  { name: 'Gold', hex: '#D9A520', css: 'conic-gradient(#8B6500, #FFD447, #FFF1A0, #C98A00, #8B6500)' },
+  { name: 'Copper', hex: '#B86B44', css: 'conic-gradient(#8B4A2B, #F0B08A, #FFF0E1, #A9582E, #8B4A2B)' },
+  { name: 'Silver', hex: '#AFC0CC', css: 'conic-gradient(#5D7180, #E8F1F5, #8FA7B7, #F8FCFF, #5D7180)' },
+  { name: 'Multicolour', hex: '#C060C0', css: 'conic-gradient(#5A36FF, #F13CD4, #FF3355, #FFB000, #FFF200, #25D05A, #00CDE8, #5A36FF)' },
+  { name: 'Clear', hex: '#D5E8EE', css: 'repeating-conic-gradient(#d5e8ee 0% 25%, #8db7c9 0% 50%) 50% / 10px 10px' }
+]
+
+export interface ZrMaterial { name: string, temp: number, zr: number }
+
+// Touchscreen material list (tmt1.ini materialN index).
+// `zr` is the matching index in the ZR Tools KlipperScreen panel list.
+export const ZR_MATERIALS: ZrMaterial[] = [
+  { name: 'PLA', temp: 210, zr: 1 },
+  { name: 'PLA Silk', temp: 215, zr: 3 },
+  { name: 'ABS', temp: 250, zr: 8 },
+  { name: 'PETG', temp: 240, zr: 6 },
+  { name: 'PLA Matte', temp: 210, zr: 4 },
+  { name: 'PLA Metal', temp: 215, zr: 15 },
+  { name: 'ABS Matte', temp: 250, zr: 8 },
+  { name: 'PETG Matte', temp: 240, zr: 6 },
+  { name: 'PVA', temp: 200, zr: 13 },
+  { name: 'TPE', temp: 225, zr: 10 },
+  { name: 'Marble', temp: 210, zr: 15 },
+  { name: 'HIPS', temp: 235, zr: 14 },
+  { name: 'TPU', temp: 225, zr: 10 },
+  { name: 'PET', temp: 240, zr: 15 },
+  { name: 'Wood', temp: 200, zr: 15 },
+  { name: 'ASA', temp: 255, zr: 9 }
+]
+
+export interface ZrSlot { color: number | null, material: number | null }
+
+export const zrSwatchCss = (color: number | null | undefined): string => {
+  if (color == null || color < 0 || color >= ZR_PALETTE.length) return 'transparent'
+  const p = ZR_PALETTE[color]
+  return p.css ?? p.hex
+}
+
+export const zrColorName = (color: number | null | undefined): string => {
+  if (color == null || color < 0 || color >= ZR_PALETTE.length) return 'Not set'
+  return ZR_PALETTE[color].name
+}
+
+export const zrMaterialName = (material: number | null | undefined): string => {
+  if (material == null || material < 0 || material >= ZR_MATERIALS.length) return 'Not set'
+  return ZR_MATERIALS[material].name
+}
+
+/** Reads the four [slot] entries from tmt1.ini text. */
+export const parseTmt1Slots = (text: string): ZrSlot[] => {
+  const slots: ZrSlot[] = Array.from({ length: ZR_HEADS }, () => ({ color: null, material: null }))
+  let section = ''
+
+  for (const raw of text.split(/\r?\n/)) {
+    const line = raw.trim()
+    const sec = /^\[(.+)\]$/.exec(line)
+    if (sec) {
+      section = sec[1].trim().toLowerCase()
+      continue
+    }
+    if (section !== 'slot') continue
+
+    const kv = /^(color|material)([0-3])\s*=\s*(-?\d+)\s*$/i.exec(line)
+    if (kv) {
+      const index = +kv[2]
+      const value = +kv[3]
+      if (kv[1].toLowerCase() === 'color') {
+        slots[index].color = value >= 0 && value < ZR_PALETTE.length ? value : null
+      } else {
+        slots[index].material = value >= 0 && value < ZR_MATERIALS.length ? value : null
+      }
+    }
+  }
+
+  return slots
+}
+
+/** Returns tmt1.ini text with one slot changed, leaving every other line untouched. */
+export const updateTmt1Slot = (text: string, index: number, color: number, material: number): string => {
+  const eol = text.includes('\r\n') ? '\r\n' : '\n'
+  const lines = text.split(/\r?\n/)
+  let section = ''
+  let slotEnd = -1
+  let doneColor = false
+  let doneMaterial = false
+
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i].trim()
+    const sec = /^\[(.+)\]$/.exec(line)
+    if (sec) {
+      if (section === 'slot') slotEnd = i
+      section = sec[1].trim().toLowerCase()
+      continue
+    }
+    if (section !== 'slot') continue
+
+    if (new RegExp(`^color${index}\\s*=`, 'i').test(line)) {
+      lines[i] = `color${index}=${color}`
+      doneColor = true
+    } else if (new RegExp(`^material${index}\\s*=`, 'i').test(line)) {
+      lines[i] = `material${index}=${material}`
+      doneMaterial = true
+    }
+  }
+
+  if (doneColor && doneMaterial) return lines.join(eol)
+
+  const extra: string[] = []
+  if (!doneColor) extra.push(`color${index}=${color}`)
+  if (!doneMaterial) extra.push(`material${index}=${material}`)
+
+  if (section === 'slot' && slotEnd < 0) {
+    // [slot] is the last section: add before trailing blank lines
+    let end = lines.length
+    while (end > 0 && lines[end - 1].trim() === '') end--
+    lines.splice(end, 0, ...extra)
+  } else if (slotEnd >= 0) {
+    let at = slotEnd
+    while (at > 0 && lines[at - 1].trim() === '') at--
+    lines.splice(at, 0, ...extra)
+  } else {
+    lines.push('', '[slot]', ...extra, '')
+  }
+
+  return lines.join(eol)
+}
+
+const hexToRgb = (hex: string): [number, number, number] | null => {
+  const m = /^#?([0-9a-f]{6})/i.exec(hex.trim())
+  if (!m) return null
+  const n = parseInt(m[1], 16)
+  return [(n >> 16) & 255, (n >> 8) & 255, n & 255]
+}
+
+/** Weighted RGB distance; good enough to pick the closest declared colour. */
+export const colorDistance = (a: string, b: string): number => {
+  const x = hexToRgb(a)
+  const y = hexToRgb(b)
+  if (!x || !y) return Number.MAX_SAFE_INTEGER
+  const rm = (x[0] + y[0]) / 2
+  const dr = x[0] - y[0]
+  const dg = x[1] - y[1]
+  const db = x[2] - y[2]
+  return (2 + rm / 256) * dr * dr + 4 * dg * dg + (2 + (255 - rm) / 256) * db * db
+}
+
+export const normaliseHex = (value: string): string | null => {
+  const m = /#?([0-9a-f]{6})/i.exec(value.trim())
+  return m ? `#${m[1].toUpperCase()}` : null
+}
+
+export interface ZrFileColour { tool: number, hex: string, material?: string, grams?: number }
+
+/**
+ * Colours used by a G-code file, from Moonraker metadata.
+ * WonderMaker's Moonraker reports `preset_colours` and `filament_used_g`,
+ * stock Moonraker reports `filament_colors` and `referenced_tools`.
+ */
+export const fileColoursFromMetadata = (meta: Record<string, unknown>): ZrFileColour[] => {
+  const asList = (v: unknown): unknown[] => Array.isArray(v) ? v : (typeof v === 'string' ? v.split(/[;,]/) : [])
+  const colours = asList(meta.preset_colours ?? meta.filament_colors)
+    .map(c => normaliseHex(String(c)))
+  if (colours.length === 0) return []
+
+  const types = asList(meta.filament_type).map(t => String(t).trim())
+  const grams = asList(meta.filament_used_g).map(g => Number(g))
+  const mm = asList(meta.filament_used_mm).map(g => Number(g))
+  const referenced = Array.isArray(meta.referenced_tools) ? (meta.referenced_tools as number[]) : null
+
+  const result: ZrFileColour[] = []
+  colours.forEach((hex, tool) => {
+    if (!hex || tool >= ZR_HEADS) return
+    let used = true
+    if (referenced) {
+      used = referenced.includes(tool)
+    } else if (grams.length > tool && !Number.isNaN(grams[tool])) {
+      used = grams[tool] > 0
+    } else if (mm.length > tool && !Number.isNaN(mm[tool])) {
+      used = mm[tool] > 0
+    } else if (colours.length > 1 && tool > 0) {
+      // No usage data: assume every listed colour is used.
+      used = true
+    }
+    if (used) {
+      result.push({
+        tool,
+        hex,
+        material: types[tool] || undefined,
+        grams: grams.length > tool && !Number.isNaN(grams[tool]) ? grams[tool] : undefined
+      })
+    }
+  })
+
+  return result
+}
+
+/** Fallback when metadata has no colours: read `; filament_colour = ...` from the file tail. */
+export const fileColoursFromTail = (tail: string): ZrFileColour[] => {
+  const colourLine = /;\s*filament_colou?r\s*=\s*(.*)/i.exec(tail)
+  if (!colourLine) return []
+  const meta: Record<string, unknown> = { preset_colours: colourLine[1] }
+  const grams = /;\s*filament used \[g\]\s*=\s*(.*)/i.exec(tail)
+  if (grams) meta.filament_used_g = grams[1]
+  const types = /;\s*filament_type\s*=\s*(.*)/i.exec(tail)
+  if (types) meta.filament_type = types[1]
+  return fileColoursFromMetadata(meta)
+}
