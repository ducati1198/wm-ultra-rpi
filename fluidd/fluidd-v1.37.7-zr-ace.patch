+      .map(name => this.zrPrinter[name]?.state as string | undefined)
+      .filter(s => s != null)
+    if (states.length === 0) return '—'
+    return states.every(s => s === DOOR_CLOSED_STATE) ? 'CLOSED' : 'OPEN'
+  }
+
+  isPrintingHead (head: ZrHead) {
+    return head.onCarriage && this.zrPrintState === 'printing'
