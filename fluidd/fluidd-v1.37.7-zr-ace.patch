+  }
+
+  get hasAirFilter () {
+    return this.zrPrinter['fan_generic air_fan'] != null
+  }
+
+  get airFilterOn () {
+    return Number(this.zrPrinter['fan_generic air_fan']?.speed ?? 0) > 0
+  }
+
+  get doorsText () {
