#!/usr/bin/env python3
"""Chamber light network service (runs as root on the TM-T1 screen board).
GET  /light         -> {"on": true|false}
POST /light         body {"on": true|false}  or  POST /light/toggle
It calls the root helper /usr/local/sbin/wm-chamber-light. The Fluidd panel on the Pi finds this service through
wm_chamber_light.json, which this service uploads to Moonraker (config folder) at start and then every 10 minutes.
usage: wm-chamber-light-http [--port 8765] [--conf /home/t13dp/printer_data/config/KlipperScreen.conf]"""
import argparse
import json
import re
import socket
import subprocess
import threading
import time
import urllib.request
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HELPER = "/usr/local/sbin/wm-chamber-light"


def helper(arg):
    r = subprocess.run([HELPER, arg], capture_output=True, text=True, timeout=8)
    out = (r.stdout or "").strip().splitlines()[-1:] or [""]
    if r.returncode != 0 or out[0] not in ("on", "off"):
        raise RuntimeError((r.stderr or "helper failed").strip())
    return out[0] == "on"


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Access-Control-Allow-Private-Network", "true")
        self.end_headers()
        self.wfile.write(data)

    def do_OPTIONS(self):
        self._send(204, {})

    def do_GET(self):
        if self.path.rstrip("/") != "/light":
            return self._send(404, {"error": "not found"})
        try:
            self._send(200, {"on": helper("status")})
        except Exception as e:
            self._send(500, {"error": str(e)})

    def do_POST(self):
        path = self.path.rstrip("/")
        try:
            if path == "/light/toggle":
                return self._send(200, {"on": helper("toggle")})
            if path != "/light":
                return self._send(404, {"error": "not found"})
            n = int(self.headers.get("Content-Length") or 0)
            want = json.loads(self.rfile.read(n) or b"{}").get("on")
            if not isinstance(want, bool):
                return self._send(400, {"error": 'send {"on": true} or {"on": false}'})
            self._send(200, {"on": helper("on" if want else "off")})
        except Exception as e:
            self._send(500, {"error": str(e)})


def moonraker_host(conf):
    try:
        m = re.search(r"^\s*moonraker_host\s*[:=]\s*(\S+)", open(conf).read(), re.M)
        return m.group(1) if m else None
    except OSError:
        return None


def my_ip_towards(host):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect((host, 7125))
        return s.getsockname()[0]
    finally:
        s.close()


def register(conf, port):
    """Tell the Pi where this service is: upload wm_chamber_light.json into Moonraker's config folder."""
    host = moonraker_host(conf)
    if not host:
        return False
    body = json.dumps({"url": "http://%s:%d" % (my_ip_towards(host), port)})
    b = uuid.uuid4().hex
    parts = ('--%s\r\nContent-Disposition: form-data; name="root"\r\n\r\nconfig\r\n'
             '--%s\r\nContent-Disposition: form-data; name="file"; filename="wm_chamber_light.json"\r\n'
             'Content-Type: application/json\r\n\r\n%s\r\n--%s--\r\n') % (b, b, body, b)
    req = urllib.request.Request("http://%s:7125/server/files/upload" % host, parts.encode(), method="POST",
                                 headers={"Content-Type": "multipart/form-data; boundary=" + b})
    urllib.request.urlopen(req, timeout=8).read()
    return True


def register_loop(conf, port):
    wait = 5
    while True:
        try:
            ok = register(conf, port)
        except Exception:
            ok = False
        time.sleep(600 if ok else wait)
        wait = min(wait * 2, 120)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=8765)
    ap.add_argument("--conf", default="/home/t13dp/printer_data/config/KlipperScreen.conf")
    a = ap.parse_args()
    threading.Thread(target=register_loop, args=(a.conf, a.port), daemon=True).start()
    ThreadingHTTPServer(("0.0.0.0", a.port), Handler).serve_forever()


if __name__ == "__main__":
    main()
